@model IEnumerable<My_Doctor.Models.Appointment>

<h2>Patient Appointments</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Patient</th>
            <th>Date</th>
            <th>Status</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.Patient?.Username</td>
                <td>@app.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@app.Status</td>
                <td>@app.Notes</td>
            </tr>
        }
    </tbody>
</table>