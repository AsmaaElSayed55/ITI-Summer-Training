@model My_Doctor.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
}

<h2>Book Appointment</h2>

<form asp-action="Book" method="post" class="p-3 border rounded bg-light" style="max-width: 600px;">
    <div class="form-group mb-3">
        <label for="DoctorId">Select Doctor</label>
        <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-control">
            <option disabled selected>-- Choose a Doctor --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Date">Appointment Date</label>
        <input asp-for="Date" class="form-control" type="datetime-local" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Notes">Notes</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Book</button>
</form>