@{
    ViewData["Title"] = "Home Page";
}

<div class="container text-center mt-5">
    <h1 class="display-4 mb-4">Welcome to My Doctor System</h1>

    <div class="row justify-content-center gap-4">

        <div class="col-md-3">
            <a href="/Account/Register" class="btn btn-outline-primary w-100 p-3">
                <i class="fas fa-user-plus fa-2x mb-2"></i><br />
                Register
            </a>
        </div>

        <div class="col-md-3">
            <a href="/Account/Login" class="btn btn-outline-success w-100 p-3">
                <i class="fas fa-sign-in-alt fa-2x mb-2"></i><br />
                Login
            </a>
        </div>

        <div class="col-md-3">
            <a href="/Appointment/Book" class="btn btn-outline-info w-100 p-3">
                <i class="fas fa-calendar-plus fa-2x mb-2"></i><br />
                Book Appointment
            </a>
        </div>

        <div class="col-md-3">
            <a href="/Appointment/MyAppointments" class="btn btn-outline-dark w-100 p-3">
                <i class="fas fa-calendar-check fa-2x mb-2"></i><br />
                My Appointments
            </a>
        </div>
    </div>
</div>
