@model My_Doctor.Models.RegisterViewModel

<h2>Register</h2>
<form asp-action="Register" method="post">
    <div class="form-group">
        <label asp-for="Username"></label>
        <input asp-for="Username" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Role"></label>
        <select asp-for="Role" class="form-control">
            <option value="Patient">Patient</option>
            <option value="Doctor">Doctor</option>
        </select>
    </div>
    <!-- Patient Fields -->
    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Gender"></label>
        <input asp-for="Gender" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="History"></label>
        <input asp-for="History" class="form-control" />
    </div>
    <!-- Doctor Fields -->
    <div class="form-group">
        <label asp-for="Specialization"></label>
        <input asp-for="Specialization" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="AvailableTimes"></label>
        <input asp-for="AvailableTimes" class="form-control" />
    </div>
    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <!-- your fields -->
        <button type="submit">Register</button>
    </form>
</form>